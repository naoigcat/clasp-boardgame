{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".review.md"],
  "config": {
    "ul-indent": {
      "indent": 4,
    },
    "line-length": {
      "line_length": 160,
      "tables": false,
    },
    "list-marker-space": {
      "ol_multi": 1,
      "ol_single": 1,
      "ul_multi": 1,
      "ul_single": 1,
    },
    "no-inline-html": false,
  },
}
