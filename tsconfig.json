{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "lib": ["ES2020"],
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["/deps/node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
