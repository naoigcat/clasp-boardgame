{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "lib": ["ES2020"],
    "rootDir": "src",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["/deps/node_modules/@types"],
    "types": ["google-apps-script"]
  },
  "include": ["src/**/*.ts"]
}
